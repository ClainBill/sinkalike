---
import Base from '../layouts/Base.astro';
import LoginForm from '../components/islands/LoginForm';
import { getAuth } from '../lib/server/auth';
import { loginMethods } from '../lib/server/senders';

export const prerender = false;

const next = Astro.url.searchParams.get('next');
const session = await getAuth().api.getSession({ headers: Astro.request.headers });
if (session) return Astro.redirect(next?.startsWith('/') && !next.startsWith('//') ? next : '/account/');
---

<Base title="Sign in" noindex>
  <div class="wrap login-wrap">
    <header class="page-head">
      <h1>Sign in</h1>
      <p>Keep your name on your comments, edit them later, and vote from any device.</p>
    </header>
    <LoginForm client:load methods={loginMethods()} next={next} dev={import.meta.env.DEV} />
  </div>
</Base>

<style>
  .login-wrap {
    max-width: 520px;
  }
</style>
