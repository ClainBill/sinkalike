---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Poster from '../../components/Poster.astro';
import Comments from '../../components/islands/Comments';
import Poll from '../../components/islands/Poll';
import HostEdit from '../../components/islands/HostEdit';
import { getMovies, getEpisodes, getPeople, playable, linesAt, mentionSnippet, speakerName, type MovieListing } from '../../lib/content';
import { timestamp } from '../../lib/format';
import { autoPollOptions } from '../../site.config';
import { getImage } from 'astro:assets';
import Copy from '../../components/Copy.astro';
import { editable } from '../../lib/editable';
import { takeText } from '../../lib/edit/content';

export async function getStaticPaths() {
  const movies = await getMovies();
  return movies.map((listing) => ({ params: { slug: listing.movie.id }, props: listing }));
}

type Props = MovieListing;

const { movie, episodes, mentions: allMentions } = Astro.props;
const { data } = movie;
const people = await getPeople();
const allEpisodes = await getEpisodes();
const { Content } = await render(movie);
const hasTake = !!movie.body?.replace(/<!--[\s\S]*?-->/g, '').trim();

const verdicts = Object.entries(data.verdicts)
  .map(([id, verdict]) => ({ id, verdict, person: people.find((p) => p.id === id) }))
  .filter((v) => v.verdict.rating !== undefined || v.verdict.take);

// Hand-picked pull quotes, resolved against the transcripts.
const pulls = data.quotes
  .map((quote) => {
    const episode = allEpisodes.find((e) => e.slug === quote.episode);
    const lines = episode?.transcript ? linesAt(episode.transcript.segments, quote.start, quote.end) : [];
    return episode && lines.length ? { episode, lines } : null;
  })
  .filter((pull) => pull !== null);

const pulledStarts = new Set(pulls.flatMap((pull) => pull.lines.map((line) => `${pull.episode.slug}:${line.s}`)));
const mentions = allMentions.filter(({ episode, segment }) => !pulledStarts.has(`${episode.slug}:${segment.s}`));
const mentionedOnly = episodes.length === 0;
const mentionEpisodes = [...new Map(allMentions.map((m) => [m.episode.slug, m.episode])).values()];
const MENTIONS_SHOWN = 8;

const ogImage = data.poster ? (await getImage({ src: data.poster, width: 600, format: 'jpg' })).src : undefined;
const heading = `${data.title}${data.year ? ` (${data.year})` : ''}`;

const pollOptions = autoPollOptions(verdicts.map((v) => v.person?.data.short ?? v.id));
const poll = data.poll ?? (pollOptions && { question: `${data.title}: who got it right?`, options: pollOptions });
---

<Base title={heading} description={data.synopsis ?? `What Sink Alike thinks about ${heading}.`} image={ogImage} type="video.movie">
  <div data-movie-slug={movie.id} data-movie-page>
  <p class="wrap removed-notice" data-removed-notice hidden><Copy k="movie.removed" text="A host has taken this movie off the list." /></p>
  <div class="wrap movie-head">
    <div class="movie-poster">
      <Poster movie={movie} width={320} eager />
    </div>
    <div class="movie-info">
      <p class="kicker"><Copy k="movie.kicker" text="Movie" /></p>
      <h1 {...editable(`movie:${movie.id}:title`, data.title)}>{data.title}</h1>
      <p class="meta movie-facts">
        <span {...editable(`movie:${movie.id}:year`, data.year, 'number', { placeholder: 'Add year' })}>{data.year}</span>
        <span {...editable(`movie:${movie.id}:director`, data.director, 'plain', { prefix: 'Directed by ', placeholder: 'Add director' })}>
          {data.director && `Directed by ${data.director}`}
        </span>
        <span {...editable(`movie:${movie.id}:runtime`, data.runtime, 'number', { suffix: ' min', placeholder: 'Add runtime (minutes)' })}>
          {data.runtime && `${data.runtime} min`}
        </span>
      </p>
      <p class="meta" {...editable(`movie:${movie.id}:genres`, data.genres, 'lines', { join: ', ', placeholder: 'Add genres (one per line)' })}>
        {data.genres.join(', ')}
      </p>

      {
        verdicts.length > 0 && (
          <div class="verdicts">
            {verdicts.map(({ id, verdict, person }) => (
              <div class={`verdict person person-${id}`}>
                <p class="verdict-who">{person?.data.short ?? id}</p>
                {verdict.rating !== undefined && (
                  <p class="verdict-score">
                    <span {...editable(`movie:${movie.id}:verdicts.${id}.rating`, verdict.rating, 'number')}>{verdict.rating}</span>
                    <span>/10</span>
                  </p>
                )}
                <p class="verdict-take" {...editable(`movie:${movie.id}:verdicts.${id}.take`, verdict.take, 'plain', { placeholder: 'Add a one-line take' })}>
                  {verdict.take}
                </p>
              </div>
            ))}
          </div>
        )
      }

      {
        episodes.length > 0 && (
          <p class="discussed">
            <Copy k="movie.discussed-in" text="Discussed in" />{' '}
            {episodes.map((episode, index) => (
              <>
                {index > 0 && ', '}
                <a href={`/episodes/${episode.slug}/`}>Episode {episode.number}: {episode.title}</a>
              </>
            ))}
          </p>
        )
      }
      {
        mentionedOnly && mentionEpisodes.length > 0 && (
          <p class="discussed">
            Mentioned {allMentions.length === 1 ? 'once' : `${allMentions.length} times`} in{' '}
            {mentionEpisodes.map((episode, index) => (
              <>
                {index > 0 && ', '}
                <a href={`/episodes/${episode.slug}/`}>Episode {episode.number}: {episode.title}</a>
              </>
            ))}
            . <Copy k="movie.no-episode-yet" text="We haven’t done a full episode on it (yet)." />
          </p>
        )
      }
      <div class="movie-admin-row">
        <div data-movie-admin></div>
        <HostEdit client:idle kind="movie" slug={movie.id} title={data.title} />
      </div>
    </div>
  </div>

  <div class="wrap movie-body">
    {mentionedOnly && !hasTake ? (
      data.synopsis && (
        <section aria-labelledby="about-title">
          <h2 id="about-title"><Copy k="movie.about" text="About the movie" /></h2>
          <div class="muted synopsis-text" {...editable(`movie:${movie.id}:synopsis`, data.synopsis, 'blocks')}>{data.synopsis}</div>
        </section>
      )
    ) : (
    <section aria-labelledby="take-title">
      <h2 id="take-title"><Copy k="movie.take" text="Our take" /></h2>
      {
        hasTake ? (
          <div class="prose" {...editable(`movie:${movie.id}:body`, takeText(movie.body ?? ''), 'markdown')}>
            <Content />
          </div>
        ) : (
          <div class="muted" {...editable(`movie:${movie.id}:body`, '', 'markdown')}>
            <p>We’re still writing this one up. In the meantime, hear what we said below.</p>
          </div>
        )
      }
      {data.synopsis && (
        <details class="synopsis">
          <summary class="meta"><Copy k="movie.synopsis" text="Official synopsis" /></summary>
          <div class="muted" {...editable(`movie:${movie.id}:synopsis`, data.synopsis, 'blocks')}>{data.synopsis}</div>
        </details>
      )}
    </section>
    )}

    {
      pulls.length > 0 && (
        <section aria-labelledby="pulls-title">
          <h2 id="pulls-title"><Copy k="movie.pulls" text="In our words" /></h2>
          <div class="pulls">
            {pulls.map(({ episode, lines }) => {
              const sp = lines[0].sp;
              return (
                <figure class:list={['pull', sp && `person person-${sp}`]} data-episode={JSON.stringify(playable(episode))}>
                  <blockquote>“{lines.map((line) => line.t).join(' ')}”</blockquote>
                  <figcaption>
                    {sp && <strong class="speaker">{speakerName(sp, people)}</strong>}
                    <a href={`/episodes/${episode.slug}/?t=${Math.floor(lines[0].s)}`} class="meta">
                      Ep {episode.number} · {timestamp(lines[0].s)}
                    </a>
                    <button type="button" class="btn btn-small" data-play={lines[0].s}>
                      ▶ <Copy k="movie.hear-it" text="Hear it" />
                    </button>
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </section>
      )
    }

    {
      mentions.length > 0 && (
        <section aria-labelledby="mentions-title">
          <h2 id="mentions-title">
            {mentionedOnly ? (
              <Copy k="movie.mentions-only" text="Where it came up" />
            ) : (
              <>
                <Copy k="movie.mentions" text="Every time we said" /> “{data.title}”
              </>
            )}
          </h2>
          <ul class="mentions">
            {mentions.map(({ episode, segment }, index) => {
              const quote = mentionSnippet(movie, segment.t, 18);
              return (
                <li data-episode={JSON.stringify(playable(episode))} hidden={index >= MENTIONS_SHOWN} data-extra-mention={index >= MENTIONS_SHOWN || undefined}>
                  <button type="button" class="stamp" data-play={segment.s} aria-label={`Play from ${timestamp(segment.s)}`}>
                    ▶ {timestamp(segment.s)}
                  </button>
                  <span class:list={['mention-text', segment.sp && `person person-${segment.sp}`]}>
                    {segment.sp && <strong>{speakerName(segment.sp, people)}: </strong>}
                    <span>
                      “{quote.before}
                      {quote.match && <mark>{quote.match}</mark>}
                      {quote.after}”
                    </span>
                  </span>
                  <a class="meta" href={`/episodes/${episode.slug}/?t=${Math.floor(segment.s)}`}>
                    Ep {episode.number}
                  </a>
                </li>
              );
            })}
          </ul>
          {mentions.length > MENTIONS_SHOWN && (
            <button type="button" class="btn btn-small" data-show-mentions>
              <Copy k="movie.show-all" text="Show all" /> {mentions.length}
            </button>
          )}
          <p class="meta">
            <a href={`/quotes/?q=${encodeURIComponent(data.title)}`}>
              <Copy k="movie.search-quotes" text="Search all quotes for" /> “{data.title}” →
            </a>
          </p>
        </section>
      )
    }

    {
      poll && (
        <Poll
          pollKey={`movie:${movie.id}`}
          question={poll.question}
          options={poll.options}
          edit={
            data.poll
              ? {
                  question: editable(`movie:${movie.id}:poll.question`, poll.question),
                  options: editable(`movie:${movie.id}:poll.options`, poll.options, 'lines', { static: true }),
                }
              : undefined
          }
          client:visible
        />
      )
    }

    <Comments thread={`movie:${movie.id}`} client:visible />
  </div>
  </div>
</Base>

<script>
  import '../../lib/movie-visibility';

  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-show-mentions]')?.addEventListener('click', (event) => {
      document.querySelectorAll<HTMLElement>('[data-extra-mention]').forEach((item) => (item.hidden = false));
      (event.currentTarget as HTMLElement).remove();
    });
  });
</script>

<style>
  .movie-head {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(28px, 5vw, 64px);
    padding-block: clamp(40px, 6vw, 72px);
    align-items: start;
  }
  .movie-info {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .movie-info h1 {
    margin-bottom: 4px;
  }
  .verdicts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin-top: 16px;
  }
  .verdict {
    border-radius: var(--radius);
    padding: 16px 18px;
    background: color-mix(in oklab, var(--c) 9%, var(--surface));
    border: 1px solid color-mix(in oklab, var(--c) 30%, transparent);
    color: var(--ink);
  }
  .verdict-who {
    font-weight: 700;
    color: var(--c);
    margin: 0;
  }
  .verdict-score {
    font-family: var(--display);
    font-size: 56px;
    line-height: 1;
    margin: 4px 0;
  }
  .verdict-score span {
    font-size: 22px;
    color: var(--ink-3);
  }
  .verdict-take {
    margin: 0;
    color: var(--ink-2);
  }
  .discussed {
    margin-top: 12px;
    color: var(--ink-2);
  }
  .movie-body {
    display: grid;
    gap: 56px;
    border-top: 1px solid var(--rule);
    padding-top: 48px;
  }
  .movie-body > :global(*) {
    max-width: 860px;
  }
  .movie-body h2 {
    margin-bottom: 20px;
  }
  .synopsis {
    margin-top: 20px;
  }
  .synopsis summary {
    cursor: pointer;
  }
  .pulls {
    display: grid;
    gap: 28px;
  }
  .pull {
    margin: 0;
    padding-left: 20px;
    border-left: 3px solid var(--c, var(--rule-strong));
    color: var(--ink);
  }
  .pull blockquote {
    margin: 0 0 12px;
    font-family: var(--display);
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
  }
  .pull figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }
  .pull .speaker {
    color: var(--c);
  }
  .mentions {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }
  .mentions li {
    padding-block: 12px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 76px 1fr auto;
    align-items: baseline;
    gap: 12px;
  }
  .mention-text {
    color: var(--ink);
  }
  .mention-text mark {
    background: color-mix(in oklab, var(--c, #f2c14e) 28%, transparent);
    color: inherit;
    border-radius: 3px;
    padding-inline: 2px;
    font-weight: 600;
  }
  .synopsis-text {
    font-size: 18px;
    max-width: 65ch;
  }
  .removed-notice {
    margin-top: 24px;
    padding: 12px 16px;
    border-radius: 10px;
    background: #f2c14e;
    color: #17161a;
    font-weight: 500;
  }
  .movie-facts > span:not([data-edit-empty]) ~ span:not([data-edit-empty])::before {
    content: ' · ';
  }
  .movie-admin-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  /* Only hosts get buttons here. */
  .movie-admin-row:has(button) {
    margin-top: 8px;
  }
  .mention-text strong {
    color: var(--c);
  }
  .stamp {
    border: 1px solid var(--rule-strong);
    background: none;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .stamp:hover {
    background: var(--surface-2);
  }
  @media (max-width: 720px) {
    .movie-head {
      grid-template-columns: 1fr;
    }
    .movie-poster {
      width: 180px;
    }
  }
</style>
