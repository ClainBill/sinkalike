---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PersonChips from '../../components/PersonChips.astro';
import PlayButton from '../../components/PlayButton.astro';
import ListenOn from '../../components/ListenOn.astro';
import Poster from '../../components/Poster.astro';
import SponsorCard from '../../components/SponsorCard.astro';
import Transcript from '../../components/Transcript.astro';
import Comments from '../../components/islands/Comments';
import Poll from '../../components/islands/Poll';
import { getEpisodes, getMovies, getPeople, playable, type Episode } from '../../lib/content';
import { date, duration, stripHtml, timestamp } from '../../lib/format';
import { site } from '../../site.config';
import Copy from '../../components/Copy.astro';
import { editable, episodeDescription, episodeTitle } from '../../lib/editable';

export async function getStaticPaths() {
  const episodes = await getEpisodes();
  return episodes.map((episode, index) => ({
    params: { slug: episode.slug },
    props: { episode, newer: episodes[index - 1], older: episodes[index + 1] },
  }));
}

interface Props {
  episode: Episode;
  newer?: Episode;
  older?: Episode;
}

const { episode, newer, older } = Astro.props;
const people = await getPeople();
const notes = episode.extras ? await render(episode.extras) : undefined;
const hasNotes = !!episode.extras?.body?.replace(/<!--[\s\S]*?-->/g, '').trim();
const play = playable(episode);
const notesText = episode.extras?.body?.replace(/<!--[\s\S]*?-->/g, '').trim() ?? '';

// Other movies that came up in this episode, with the first moment each was said.
const alsoMentioned = (await getMovies())
  .filter((listing) => !episode.movies.some((m) => m.id === listing.movie.id))
  .map((listing) => ({ ...listing, here: listing.mentions.filter((m) => m.episode.slug === episode.slug) }))
  .filter((listing) => listing.here.length > 0)
  .sort((a, b) => a.here[0].segment.s - b.here[0].segment.s);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: episode.title,
  episodeNumber: episode.number,
  datePublished: episode.published.toISOString(),
  description: stripHtml(episode.description),
  url: new URL(`/episodes/${episode.slug}/`, site.url).toString(),
  timeRequired: `PT${Math.round(episode.duration / 60)}M`,
  associatedMedia: { '@type': 'MediaObject', contentUrl: episode.audio.url },
  partOfSeries: { '@type': 'PodcastSeries', name: site.name, url: site.url, webFeed: site.feedUrl },
  actor: episode.participants.map((person) => ({ '@type': 'Person', name: person.data.name })),
};
---

<Base title={episode.title} description={stripHtml(episode.description)} type="article" jsonLd={jsonLd}>
  <article>
    <header class="wrap episode-head">
      <div class="episode-head-text">
      <p class="kicker"><Copy k="episode.kicker" text="Episode" /> {episode.number}</p>
      <h1 {...episodeTitle(episode)}>{episode.title}</h1>
      <p class="meta">
        <time datetime={episode.published.toISOString()}>{date(episode.published)}</time> · {duration(episode.duration)}
      </p>
      <PersonChips people={episode.participants} guests={episode.guests} />
      <div class="episode-actions">
        <PlayButton episode={play} />
        <ListenOn episodeLink={episode.link} youtube={episode.youtube} />
      </div>
      </div>
      {
        episode.movies[0] && (
          <a class="episode-head-poster" href={`/movies/${episode.movies[0].id}/`} aria-label={`${episode.movies[0].data.title}: our take`}>
            <Poster movie={episode.movies[0]} width={240} eager />
          </a>
        )
      }
    </header>

    <div class="wrap episode-grid">
      <div class="episode-main">
        <section class="prose description" aria-label="Episode description">
          <div {...episodeDescription(episode)}><Fragment set:html={episode.description} /></div>
          {episode.extras && (
            <div {...editable(`episode:${episode.slug}:body`, notesText, 'markdown', { placeholder: 'Add show notes (Markdown)' })}>
              {hasNotes && notes && <notes.Content />}
            </div>
          )}
        </section>

        {
          episode.chapters.length > 0 && (
            <section class="chapters" aria-labelledby="chapters-title" data-episode={JSON.stringify(play)}>
              <h2 id="chapters-title"><Copy k="episode.chapters" text="Chapters" /></h2>
              <ol>
                {episode.chapters.map((chapter) => (
                  <li>
                    <button type="button" data-play={chapter.start}>
                      <span class="meta">{timestamp(chapter.start)}</span> {chapter.title}
                    </button>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {episode.transcript ? <Transcript episode={episode} people={people} /> : (
          <section class="card empty">
            <h2><Copy k="transcript.title" text="Transcript" /></h2>
            <p class="muted"><Copy k="episode.no-transcript" text="The transcript for this episode is on its way." /></p>
          </section>
        )}

        <Comments thread={`episode:${episode.slug}`} client:visible />
      </div>

      <aside class="episode-aside">
        {
          episode.movies.length > 0 && (
            <section aria-labelledby="movies-title">
              <h2 id="movies-title" class="kicker"><Copy k="episode.movies" text="Movies discussed" /></h2>
              <ul class="aside-movies">
                {episode.movies.map((movie) => (
                  <li>
                    <a href={`/movies/${movie.id}/`}>
                      <Poster movie={movie} width={88} />
                      <span>
                        <strong {...editable(`movie:${movie.id}:title`, movie.data.title)}>{movie.data.title}</strong>
                        <span class="meta">{movie.data.year}</span>
                        <span class="meta"><Copy k="episode.movie-link" text="Our take & pull quotes →" /></span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          alsoMentioned.length > 0 && (
            <section aria-labelledby="mentioned-title" data-episode={JSON.stringify(play)}>
              <h2 id="mentioned-title" class="kicker"><Copy k="episode.mentioned" text="Also mentioned" /></h2>
              <ul class="also-mentioned">
                {alsoMentioned.map(({ movie, here }) => (
                  <li data-movie-slug={movie.id}>
                    <a href={`/movies/${movie.id}/`} {...editable(`movie:${movie.id}:title`, movie.data.title)}>{movie.data.title}</a>
                    {movie.data.year && <span class="meta"> ({movie.data.year})</span>}
                    <button type="button" class="stamp" data-play={here[0].segment.s} aria-label={`Play where ${movie.data.title} comes up`}>
                      ▶ {timestamp(here[0].segment.s)}
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          episode.poll && (
            <Poll
              pollKey={`episode:${episode.slug}`}
              question={episode.poll.question}
              options={episode.poll.options}
              edit={{
                question: editable(`episode:${episode.slug}:poll.question`, episode.poll.question),
                options: editable(`episode:${episode.slug}:poll.options`, episode.poll.options, 'lines', { static: true }),
              }}
              client:visible
            />
          )
        }
        <SponsorCard compact />
      </aside>
    </div>

    <nav class="wrap pager" aria-label="More episodes">
      {older ? <a href={`/episodes/${older.slug}/`}>← Ep {older.number}: {older.title}</a> : <span />}
      {newer ? <a href={`/episodes/${newer.slug}/`}>Ep {newer.number}: {newer.title} →</a> : <span />}
    </nav>
  </article>
</Base>

<script>
  import '../../lib/movie-visibility';
</script>

<style>
  .episode-head {
    padding-block: clamp(40px, 6vw, 64px) 40px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: end;
  }
  .episode-head-text {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .episode-head-poster {
    width: 220px;
  }
  .episode-head h1 {
    max-width: 18ch;
  }
  .episode-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 8px;
  }
  .episode-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
    border-top: 1px solid var(--rule);
    padding-top: 40px;
  }
  .episode-main {
    display: grid;
    gap: 56px;
  }
  .episode-aside {
    display: grid;
    gap: 28px;
  }
  .aside-movies {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 12px;
  }
  .aside-movies a {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 14px;
    align-items: center;
    text-decoration: none;
  }
  .aside-movies a span {
    display: grid;
    gap: 2px;
  }
  .aside-movies a:hover strong {
    text-decoration: underline;
  }
  .also-mentioned {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: grid;
    gap: 6px;
  }
  .also-mentioned li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }
  .also-mentioned .stamp {
    margin-left: auto;
    border: 1px solid var(--rule-strong);
    background: none;
    border-radius: 999px;
    padding: 1px 9px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .also-mentioned .stamp:hover {
    background: var(--surface-2);
  }
  .chapters ol {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }
  .chapters button {
    border: 0;
    background: none;
    padding: 8px 0;
    cursor: pointer;
    text-align: left;
    display: flex;
    gap: 12px;
  }
  .chapters button:hover {
    text-decoration: underline;
  }
  .empty h2 {
    margin-bottom: 8px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-block: 56px 0;
    font-size: 15px;
  }
  @media (max-width: 720px) {
    .episode-head {
      grid-template-columns: 1fr;
    }
    .episode-head-poster {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .episode-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
