---
import type { Person } from '../lib/content';
import { initials } from '../lib/format';

interface Props {
  people: Person[];
  guests?: { name: string; url?: string }[];
  link?: boolean;
}
const { people, guests = [], link = true } = Astro.props;
---

<ul class="chips" aria-label="With">
  {
    people.map((person) => {
      const Tag = link ? 'a' : 'span';
      return (
        <li>
          <Tag class={`chip person-${person.id}`} href={link ? `/about/#${person.id}` : undefined}>
            <span class="dot" aria-hidden="true">{initials(person.data.name)}</span>
            {person.data.short}
          </Tag>
        </li>
      );
    })
  }
  {
    guests.map((guest) => (
      <li>
        <span class="chip person" style="--c: var(--person-guest)">
          <span class="dot" aria-hidden="true">{initials(guest.name)}</span>
          {guest.name}
          <span class="sr-only">(guest)</span>
        </span>
      </li>
    ))
  }
</ul>
