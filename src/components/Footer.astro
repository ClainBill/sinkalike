---
import Copy from './Copy.astro';
import { editable } from '../lib/editable';
import { site, listenOn, sponsor } from '../site.config';
const year = new Date().getFullYear();
const links = listenOn.filter((link) => link.url);
---

<footer class="site-footer">
  <div class="wrap">
    <a class="sponsor-strip" href={sponsor.url} target="_blank" rel="sponsored noopener">
      <span class="kicker"><Copy k="sponsor.supported-by" text="Supported by" /></span>
      <span><strong {...editable('site:sponsor.name', sponsor.name)}>{sponsor.name}</strong>: <span {...editable('site:sponsor.short', sponsor.short)}>{sponsor.short}</span></span>
      {sponsor.code && <span class="code"><Copy k="footer.code" text="Code" /> <b {...editable('site:sponsor.code', sponsor.code)}>{sponsor.code}</b></span>}
      <span aria-hidden="true">↗</span>
    </a>
    <div class="footer-grid">
      <div>
        <p class="footer-mark"><Copy k="wordmark" text="Sink *Alike*" /></p>
        <p class="muted" {...editable('site:tagline', site.tagline)}>{site.tagline}</p>
      </div>
      <nav aria-label="Footer">
        <p class="kicker"><Copy k="footer.explore" text="Explore" /></p>
        <a href="/episodes/"><Copy k="nav.episodes" text="Episodes" /></a>
        <a href="/movies/"><Copy k="nav.movies" text="Movies" /></a>
        <a href="/quotes/"><Copy k="footer.quotes" text="Quote search" /></a>
        <a href="/about/"><Copy k="footer.about" text="About us" /></a>
        <a href="/sponsor/"><Copy k="footer.sponsor" text="Sponsor" /></a>
      </nav>
      <nav aria-label="Listen">
        <p class="kicker"><Copy k="footer.listen" text="Listen" /></p>
        {links.map((link) => <a href={link.url} target="_blank" rel="noopener">{link.label}</a>)}
      </nav>
      <nav aria-label="Contact">
        <p class="kicker"><Copy k="footer.say-hi" text="Say hi" /></p>
        <a href={`mailto:${site.email}`} {...editable('site:email', site.email)}>{site.email}</a>
      </nav>
    </div>
    <p class="fine">
      © {year}{' '}
      <Copy
        k="footer.fine-print"
        text="Adam Estock, William Gill & Ty Wilkinson. Movie data and posters from [TMDB](https://www.themoviedb.org/). This site uses TMDB but is not endorsed or certified by TMDB. [Privacy](/privacy/)"
      />
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 48px;
    padding-block: 32px 40px;
    font-size: 15px;
  }
  .sponsor-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: var(--surface-2);
    text-decoration: none;
    margin-bottom: 40px;
  }
  .sponsor-strip:hover {
    background: color-mix(in oklab, var(--surface-2) 70%, var(--rule));
  }
  .sponsor-strip .code {
    font-family: var(--mono);
    font-size: 13px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.4fr;
    gap: 32px;
  }
  .footer-grid nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .footer-grid nav a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .footer-grid nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .footer-grid .kicker {
    margin-bottom: 6px;
  }
  .footer-mark {
    font-family: var(--display);
    font-size: 32px;
    line-height: 1;
    margin-bottom: 10px;
  }
  .fine {
    margin-top: 40px;
    font-size: 13px;
    color: var(--ink-3);
  }
  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-grid > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
