---
import { site, listenOn, sponsor } from '../site.config';
const year = new Date().getFullYear();
const links = listenOn.filter((link) => link.url);
---

<footer class="site-footer">
  <div class="wrap">
    <a class="sponsor-strip" href={sponsor.url} target="_blank" rel="sponsored noopener">
      <span class="kicker">Supported by</span>
      <span><strong>{sponsor.name}</strong>: {sponsor.short}</span>
      {sponsor.code && <span class="code">Code <b>{sponsor.code}</b></span>}
      <span aria-hidden="true">↗</span>
    </a>
    <div class="footer-grid">
      <div>
        <p class="footer-mark">Sink <em>Alike</em></p>
        <p class="muted">{site.tagline}</p>
      </div>
      <nav aria-label="Footer">
        <p class="kicker">Explore</p>
        <a href="/episodes/">Episodes</a>
        <a href="/movies/">Movies</a>
        <a href="/quotes/">Quote search</a>
        <a href="/about/">About us</a>
        <a href="/sponsor/">Sponsor</a>
      </nav>
      <nav aria-label="Listen">
        <p class="kicker">Listen</p>
        {links.map((link) => <a href={link.url} target="_blank" rel="noopener">{link.label}</a>)}
      </nav>
      <nav aria-label="Contact">
        <p class="kicker">Say hi</p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </nav>
    </div>
    <p class="fine">
      © {year} Adam Estock &amp; William Gill. Movie data and posters from{' '}
      <a href="https://www.themoviedb.org/" target="_blank" rel="noopener">TMDB</a>. This site uses TMDB but is not endorsed or
      certified by TMDB. <a href="/privacy/">Privacy</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 48px;
    padding-block: 32px 40px;
    font-size: 15px;
  }
  .sponsor-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: var(--surface-2);
    text-decoration: none;
    margin-bottom: 40px;
  }
  .sponsor-strip:hover {
    background: color-mix(in oklab, var(--surface-2) 70%, var(--rule));
  }
  .sponsor-strip .code {
    font-family: var(--mono);
    font-size: 13px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.4fr;
    gap: 32px;
  }
  .footer-grid nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .footer-grid nav a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .footer-grid nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .footer-grid .kicker {
    margin-bottom: 6px;
  }
  .footer-mark {
    font-family: var(--display);
    font-size: 32px;
    line-height: 1;
    margin-bottom: 10px;
  }
  .fine {
    margin-top: 40px;
    font-size: 13px;
    color: var(--ink-3);
  }
  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-grid > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
