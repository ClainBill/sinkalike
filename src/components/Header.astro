---
import AccountLink from './islands/AccountLink';

const nav = [
  { href: '/episodes/', label: 'Episodes' },
  { href: '/movies/', label: 'Movies' },
  { href: '/quotes/', label: 'Quotes' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/" aria-label="Sink Alike home">Sink <em>Alike</em></a>
    <nav class="site-nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <button class="icon-btn theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
      </button>
      <AccountLink client:idle transition:persist="account" />
    </div>
  </div>
</header>

<script>
  function setup() {
    const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
    if (!button || button.dataset.ready) return;
    button.dataset.ready = '1';
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme
        ? root.dataset.theme === 'dark'
        : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try {
        localStorage.setItem('sa:theme', root.dataset.theme);
      } catch {}
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 68px;
  }
  .wordmark {
    font-family: var(--display);
    font-size: 28px;
    line-height: 1;
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .wordmark em {
    font-style: italic;
  }
  .site-nav {
    display: flex;
    gap: 4px;
    margin-left: 12px;
  }
  .site-nav a {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 999px;
  }
  .site-nav a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--surface-2);
  }
  .header-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .theme-toggle .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle .moon {
      display: block;
    }
  }

  @media (max-width: 720px) {
    .header-inner {
      flex-wrap: wrap;
      gap: 0;
      padding-top: 12px;
    }
    .site-nav {
      order: 3;
      width: calc(100% + 2 * var(--gutter));
      margin: 8px calc(-1 * var(--gutter)) 0;
      padding: 0 calc(var(--gutter) - 12px) 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
</style>
