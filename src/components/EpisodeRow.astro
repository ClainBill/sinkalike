---
import { episodeDescription, episodeTitle } from '../lib/editable';
import type { Episode } from '../lib/content';
import { playable } from '../lib/content';
import { date, duration, stripHtml } from '../lib/format';
import PersonChips from './PersonChips.astro';
import PlayButton from './PlayButton.astro';
import Poster from './Poster.astro';

interface Props {
  episode: Episode;
}
const { episode } = Astro.props;
const people = [...episode.participants.map((p) => p.id), ...episode.guests.map(() => 'guest')];
---

<article class="episode-row" data-people={people.join(' ')}>
  <p class="num" aria-hidden="true">{episode.number}</p>
  <div class="body">
    <p class="meta">
      Episode {episode.number} · <time datetime={episode.published.toISOString()}>{date(episode.published)}</time> · {duration(episode.duration)}
      {episode.transcript && ' · Transcript'}
    </p>
    <h3><a href={`/episodes/${episode.slug}/`} {...episodeTitle(episode)}>{episode.title}</a></h3>
    <div class="desc" {...episodeDescription(episode)}>{stripHtml(episode.description)}</div>
    <div class="foot">
      <PlayButton episode={playable(episode)} label="Play" />
      <PersonChips people={episode.participants} guests={episode.guests} />
    </div>
  </div>
  {
    episode.movies.length > 0 && (
      <ul class="posters" aria-label="Movies discussed">
        {episode.movies.slice(0, 3).map((movie) => (
          <li>
            <a href={`/movies/${movie.id}/`}>
              <Poster movie={movie} width={96} />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .episode-row {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 24px;
    padding-block: 28px;
    border-top: 1px solid var(--rule);
  }
  .num {
    font-family: var(--display);
    font-size: 56px;
    line-height: 0.9;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }
  h3 {
    font-size: clamp(24px, 3vw, 30px);
    margin: 6px 0 8px;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .desc {
    color: var(--ink-2);
    max-width: 62ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .posters {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .posters :global(.poster) {
    width: 96px;
  }
  @media (max-width: 720px) {
    .episode-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .num {
      display: none;
    }
    .posters {
      order: -1;
    }
    .posters :global(.poster) {
      width: 64px;
    }
  }
</style>
