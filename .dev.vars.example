# Copy to .dev.vars for local development. Never commit .dev.vars.
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
IP_HASH_SALT=another-long-random-string
ADMINS=willcharlesgill@gmail.com

# Cloudflare Turnstile test secret (always passes). Real keys: dash.cloudflare.com → Turnstile.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional locally. Without these, login codes are printed in the dev server terminal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Movie details and posters: `npm run add-movie`, `find-movies`, and adding movies from the site.
TMDB_API_KEY=

# Editing from the site (hosts only). Each save is a commit to this repo and branch.
# Locally, point GITHUB_BRANCH at a scratch branch so test edits don't go live.
GITHUB_TOKEN=
GITHUB_REPO=ClainBill/sinkalike
GITHUB_BRANCH=site-edits-test
